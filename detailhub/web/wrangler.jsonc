{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detailhub",
  "main": ".open-next/worker-embedded.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "detailhub.com.br", "custom_domain": true },
    { "pattern": "www.detailhub.com.br", "custom_domain": true },
    { "pattern": "wingard.detailhub.com.br", "custom_domain": true }
  ]
}
