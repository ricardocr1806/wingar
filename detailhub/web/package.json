{
  "name": "detailhub-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gerar-apresentacao.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/gerar-apresentacao.mjs && tsc --noEmit",
    "deploy": "npm run build:cf && wrangler deploy",
    "build:cf": "node scripts/gerar-apresentacao.mjs && opennextjs-cloudflare build && node scripts/embed-assets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "geist": "^1.9.2",
    "next": "^15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
