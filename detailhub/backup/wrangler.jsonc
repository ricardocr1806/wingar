// Backup diário do banco do DetailHub: um Worker separado, sem endereço público, que roda sozinho todo dia
// às 03:00 (Brasília) e guarda a cópia no R2 (incluído no plano Workers Paid, sem custo extra até 10 GB).
{
  "name": "detailhub-backup",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "preview_urls": false,
  "triggers": { "crons": ["0 6 * * *"] },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "detailhub-backups" }],
  "vars": { "SUPABASE_URL": "https://sttggtxagtpmudakandu.supabase.co" }
  // Segredo (colocado no painel do Cloudflare, nunca no código): SUPABASE_SERVICE_KEY
}
